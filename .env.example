APP_ENV=development
APP_NAME=TradingGPT Options
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/tradinggpt_options.db

TRADING_MODE=PAPER
PAPER_INITIAL_CAPITAL=100000
LIVE_TRADING_ENABLED=false

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# Explicit NSE spot instruments used to derive ATM strikes; semicolon-separated.
# Example: NIFTY=NSE:NIFTY 50;BANKNIFTY=NSE:NIFTY BANK
KITE_UNDERLYING_SPOT_INSTRUMENTS=

LOG_LEVEL=INFO
